# Copy to .env. Values are for local development; see BUILD_PHASES.md Appendix B.
# Docker Compose overrides DATABASE_URL and REDIS_URL to point at its own services.
DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-not-secret-replace-with-a-long-random-string-in-production
DATABASE_URL=postgres://erp:erp@localhost:5432/erp
REDIS_URL=redis://localhost:6379/0
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
SENTRY_DSN=

# Telegram bot (Phase 4)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BOT_SERVICE_TOKEN=
API_BASE_URL=http://localhost:8000/api/v1

# Business rules (0 until the client sets a discount limit)
MAX_SALESPERSON_DISCOUNT_PCT=0

# Backups (Phase 5)
BACKUP_BUCKET_URL=
